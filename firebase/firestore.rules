const ruleExample = `rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{playerId} {
      allow read: if request.auth != null && request.auth.uid == playerId;
      allow write: if request.auth != null && request.auth.uid == playerId;
    }
    match /leaderboards/{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}`;

const securityRules = `
# Use this file in Firebase Firestore Rules or in a Cloud Functions deployment script.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{playerId} {
      allow read, write: if request.auth != null && request.auth.uid == playerId;
    }
    match /missions/{missionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /shop/{itemId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
`;

if (typeof window !== 'undefined') {
  window.__gChessSecurityRules = securityRules;
}
